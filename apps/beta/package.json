{
  "name": "beta",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node db/migrate.mjs",
    "db:purge-expired-chats": "node db/purge-expired-chats.mjs",
    "db:generate": "node -e \"console.error('drizzle-kit generate is forbidden in this repo. Beta migrations are handwritten SQL in apps/beta/db/migrations/. See ADR-0009.'); process.exit(1)\"",
    "db:push": "node -e \"console.error('drizzle-kit push is forbidden in this repo. Apply migrations via pnpm --filter beta db:migrate. See ADR-0009.'); process.exit(1)\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@workspace/email": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/registries": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "1.6.13",
    "drizzle-orm": "^0.45.2",
    "heic-decode": "2.1.0",
    "jpeg-js": "0.4.4",
    "jszip": "^3.10.1",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "postgres": "^3.4.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
