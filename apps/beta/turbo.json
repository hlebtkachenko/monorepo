{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      // Better Auth reads these at runtime, not at build time (the instance is
      // built lazily, see lib/auth/server.ts) — they are declared so the cache
      // key and the lint rule both know about them. BETTER_AUTH_SECRET and
      // NODE_ENV already live in the root globalEnv. NEXT_PHASE is set by Next
      // itself during `next build`; the auth module keys its build placeholder
      // on it.
      //
      // The DOCUMENTS_* / AWS_* four are the same story for the S3 store
      // (lib/storage/document-store-s3.ts): read lazily at request time, set on
      // the task definition by infra/cdk/lib/beta-app-stack.ts, declared here so
      // the turbo lint rule and the cache key both see them.
      "env": [
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "NEXT_PHASE",
        "BETA_DIST_DIR",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "DOCUMENTS_BUCKET",
        "DOCUMENTS_KMS_KEY_ID",
        "BETA_ASSISTANT_ENABLED",
        "BETA_ASSISTANT_API_KEY",
        "BETA_ASSISTANT_MODEL",
        "BETA_ASSISTANT_MAX_TOKENS",
        "BETA_ASSISTANT_HISTORY_MESSAGES",
        "BETA_ASSISTANT_USER_DAILY_MESSAGES",
        "BETA_ASSISTANT_MONTHLY_TOKEN_BUDGET",
        "BETA_ASSISTANT_MAX_INPUT_CHARS"
      ]
    },
    "typecheck": {
      "env": [
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "NEXT_PHASE",
        "BETA_DIST_DIR",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "DOCUMENTS_BUCKET",
        "DOCUMENTS_KMS_KEY_ID",
        "BETA_ASSISTANT_ENABLED",
        "BETA_ASSISTANT_API_KEY",
        "BETA_ASSISTANT_MODEL",
        "BETA_ASSISTANT_MAX_TOKENS",
        "BETA_ASSISTANT_HISTORY_MESSAGES",
        "BETA_ASSISTANT_USER_DAILY_MESSAGES",
        "BETA_ASSISTANT_MONTHLY_TOKEN_BUDGET",
        "BETA_ASSISTANT_MAX_INPUT_CHARS"
      ]
    },
    "lint": {
      "env": [
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "NEXT_PHASE",
        "BETA_DIST_DIR",
        "AWS_REGION",
        "AWS_DEFAULT_REGION",
        "DOCUMENTS_BUCKET",
        "DOCUMENTS_KMS_KEY_ID",
        "BETA_ASSISTANT_ENABLED",
        "BETA_ASSISTANT_API_KEY",
        "BETA_ASSISTANT_MODEL",
        "BETA_ASSISTANT_MAX_TOKENS",
        "BETA_ASSISTANT_HISTORY_MESSAGES",
        "BETA_ASSISTANT_USER_DAILY_MESSAGES",
        "BETA_ASSISTANT_MONTHLY_TOKEN_BUDGET",
        "BETA_ASSISTANT_MAX_INPUT_CHARS"
      ]
    },
    "test": {
      // DATABASE_URL is set by tests/global-setup.ts after the Postgres 18
      // testcontainer boots (and read by db/client.ts); SKIP_TESTCONTAINER is
      // the escape hatch that reuses an externally-provided database instead.
      //
      // BETA_DIST_DIR is set BY the suite, not read from it: the real-HTTP
      // header check boots its own `next dev` into an isolated build directory
      // (see next.config.mjs). Declared so the value cannot silently change a
      // cached result.
      "env": [
        "DATABASE_URL",
        "SKIP_TESTCONTAINER",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "NEXT_PHASE",
        "BETA_DIST_DIR",
        "BETA_ASSISTANT_ENABLED",
        "BETA_ASSISTANT_API_KEY",
        "BETA_ASSISTANT_MODEL",
        "BETA_ASSISTANT_MAX_TOKENS",
        "BETA_ASSISTANT_HISTORY_MESSAGES",
        "BETA_ASSISTANT_USER_DAILY_MESSAGES",
        "BETA_ASSISTANT_MONTHLY_TOKEN_BUDGET",
        "BETA_ASSISTANT_MAX_INPUT_CHARS"
      ]
    }
  }
}
